# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Distribution / packaging ───
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# ─── Virtual environments ───
.env
.venv/
venv/
ENV/

# ─── IDE / Editor ───
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Data (large image/label files — too big for GitHub) ───
data/raw/*
data/processed/*
data/splits/train/images/*
data/splits/train/labels/*
data/splits/val/images/*
data/splits/val/labels/*
data/splits/test/images/*
data/splits/test/labels/*
data/annotations/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/train/images/.gitkeep
!data/splits/train/labels/.gitkeep
!data/splits/val/images/.gitkeep
!data/splits/val/labels/.gitkeep
!data/splits/test/images/.gitkeep
!data/splits/test/labels/.gitkeep
!data/annotations/.gitkeep

# ─── Model weights (too large for GitHub) ───
*.pt
*.onnx

# ─── Training runs & outputs ───
runs/
outputs/

# ─── Logs ───
*.log

# ─── OS files ───
.DS_Store
Thumbs.db

# ─── Temp ───
*.tmp
*.temp
*.cache
